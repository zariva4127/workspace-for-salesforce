{
  "manifest_version": 3,
  "name": "Salesforce Workspace",
  "short_name": "SF Workspace",
  "version": "0.0.0",
  "description": "Side panel workspace for Salesforce admins, developers, and testers: inspect records, explain access, and capture test evidence.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Salesforce Workspace in a new window",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "storage", "identity", "activeTab", "tabs", "cookies"],
  "host_permissions": [
    "https://*.salesforce.com/*",
    "https://*.my.salesforce.com/*",
    "https://*.lightning.force.com/*",
    "https://*.my.salesforce-setup.com/*",
    "https://login.salesforce.com/*",
    "https://test.salesforce.com/*"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open Salesforce Workspace in a new window"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' data: blob:"
  }
}
